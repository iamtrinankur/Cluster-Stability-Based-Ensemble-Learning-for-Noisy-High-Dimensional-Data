# Auto-detect text files and normalize line endings
* text=auto

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.cff text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Git LFS tracking for large benchmark datasets and research PDFs
data/clean/*.csv filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text